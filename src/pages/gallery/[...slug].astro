---
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';

export async function getStaticPaths() {
  const works = await getCollection('gallery');
  return works.map((work) => ({
    params: { slug: work.id },
    props: { work },
  }));
}

const { work } = Astro.props;
const { Content } = await render(work);
---
<Base title={work.data.title}>
  <article>
    <h1>{work.data.title}</h1>
    <img src={work.data.image} alt={work.data.title} />
    <time>{work.data.date.toLocaleDateString('zh-CN')}</time>
    <Content />
  </article>
  <a href="/gallery">← 返回摄影作品</a>
</Base>
